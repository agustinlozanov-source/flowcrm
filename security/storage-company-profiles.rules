// FRAGMENTO — no publicar suelto. Ver security/README.md
//
// Inserta este bloque dentro del `match /b/{bucket}/o { … }` que ya existe en
// las reglas de Storage de tu consola.
//
// Hoy Storage rechaza toda escritura sin autenticar (403), que es justo lo que
// impedía que el cliente del formulario subiera archivos. Este bloque le abre
// exclusivamente su propia carpeta, apoyándose en el claim `profileId` del
// custom token que emite profile-session.js.

match /company-profiles/{profileId}/assets/{fileName} {

  function ownsProfile() {
    return request.auth != null && request.auth.token.profileId == profileId;
  }

  // Límites espejo de los del formulario (§3.1 de la spec): si alguien salta la
  // validación del browser, la regla la vuelve a aplicar.
  function archivoAceptable() {
    return request.resource.size <= 25 * 1024 * 1024
      && request.resource.contentType.matches(
           'application/pdf'
           + '|application/msword'
           + '|application/vnd\\.openxmlformats-officedocument\\..*'
           + '|application/vnd\\.ms-(excel|powerpoint)'
           + '|image/(jpeg|png|webp)'
           + '|text/(plain|markdown|csv)'
         );
  }

  allow read: if ownsProfile();
  allow write: if ownsProfile() && archivoAceptable();

  // Nota: el superadmin no aparece aquí porque las reglas de Storage no pueden
  // consultar Firestore para verificar el rol. El panel abre los archivos con la
  // URL de getDownloadURL(), que lleva token de descarga y no pasa por reglas.
}
