// Reglas de Firestore — archivo COMPLETO, listo para pegar en la consola.
//
// Estado: cierra company_profiles (ya publicado), users y organizations.
// El resto de las colecciones sigue abierto, marcado abajo como pendiente.
//
// ── Modelo de acceso, según el código ────────────────────────────────────────
//
//   users/{uid}.orgId                        → a qué organización pertenece
//   users/{uid}.role == 'superadmin'         → acceso al panel (Superadmin.jsx)
//
// La pertenencia se resuelve por users/{uid}.orgId, que es lo que lee useAuth.js
// (línea 44). Se probó primero con organizations/{orgId}/members/{uid}, pero eso
// obligaba a interpolar un argumento dentro de exists() y el motor de reglas lo
// rechazaba.
//
// Debajo de organizations/{orgId} cuelgan 13 subcolecciones, incluida `leads`:
//   agent_files · agent_resources · alerts · appointments · brandKits
//   flowhub_goals · goals · invites · leads · members · pipeline_stages
//   pipelines · products · settings
//
// ── Lo que obliga a hacer excepciones ────────────────────────────────────────
//
// JoinPage (/join) valida la invitación ANTES de que exista sesión: lee el
// documento de la organización, lista las invitaciones filtrando por código,
// marca como expirada la que venció, y lee el miembro que invitó para mostrar
// su nombre. Si esas cuatro operaciones exigieran autenticación, nadie podría
// volver a unirse a un equipo.
//
// Esas excepciones están acotadas lo más posible y marcadas con PENDIENTE. La
// forma correcta de cerrarlas es mover la validación de invitaciones a una
// function, igual que se hizo con el acceso del formulario de perfil en
// netlify/functions/profile-session.js.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auxiliares ────────────────────────────────────────────────────────

    function isSuperadmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    // Sin parámetros, igual que isSuperadmin(). Una versión anterior recibía el
    // orgId y lo interpolaba dentro de la ruta de exists(), y el simulador
    // respondía "Function not found error: Name: [exists]". La comparación con
    // el orgId se hace ahora en el punto de llamada, donde es una variable del
    // match y no un argumento.
    function tengoUsuario() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // useAuth.js usa users/{uid}.orgId como fuente de verdad de a qué
    // organización pertenece cada quien; las reglas siguen el mismo criterio.
    function miOrgId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId;
    }

    function ownsProfile(profileId) {
      return request.auth != null && request.auth.token.profileId == profileId;
    }

    // ── users ─────────────────────────────────────────────────────────────
    // Cada quien su propio documento. El superadmin ve todos.

    match /users/{userId} {
      allow get: if request.auth != null && (request.auth.uid == userId || isSuperadmin());
      allow list: if isSuperadmin();
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isSuperadmin());
      allow delete: if isSuperadmin();
    }

    // ── organizations ─────────────────────────────────────────────────────

    match /organizations/{orgId} {

      // PENDIENTE: lectura pública del documento de la organización. La usa
      // /join para mostrar a qué empresa te invitaron. `list` sí queda cerrado,
      // así que hay que conocer el orgId; no se pueden enumerar.
      allow get: if true;
      allow list: if isSuperadmin();

      allow create: if request.auth != null;
      allow update: if (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();
      allow delete: if isSuperadmin();

      // Invitaciones
      match /invites/{inviteId} {
        // PENDIENTE: /join necesita buscarlas por código sin sesión, y las
        // reglas no pueden exigir que la consulta venga filtrada. Es decir:
        // quien conozca el orgId puede listar las invitaciones pendientes.
        allow read: if true;

        // La única escritura sin sesión que hace /join es marcar como expirada
        // una invitación vencida. Se permite exactamente eso y nada más.
        allow update: if ((tengoUsuario() && miOrgId() == orgId) || isSuperadmin())
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'expired');

        allow create, delete: if (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();
      }

      // Miembros
      match /members/{memberId} {
        // PENDIENTE: /join lee el miembro que invitó para mostrar su nombre,
        // sin sesión. Requiere conocer orgId y el id del miembro.
        allow get: if true;
        allow list: if (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();

        // Alta propia: la hace JoinPage al unirse, y useAuth.js cuando el dueño
        // de la organización entra y todavía no tiene documento de miembro.
        allow create: if (request.auth != null && request.auth.uid == memberId)
          || (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();

        allow update, delete: if (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();
      }

      // Todo lo demás de la organización — aquí viven los leads.
      match /{documento=**} {
        allow read, write: if (tengoUsuario() && miOrgId() == orgId) || isSuperadmin();
      }
    }

    // ── company_profiles ──────────────────────────────────────────────────

    match /company_profiles/{profileId} {

      allow create, delete: if isSuperadmin();
      allow read, update: if isSuperadmin();

      allow read: if ownsProfile(profileId);

      allow update: if ownsProfile(profileId)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['accessPassword', 'clientEmail', 'companyName',
                      'failedAttempts', 'lockedUntil', 'lastAccessAt']);

      match /submissions/{submissionId} {
        allow read: if isSuperadmin();
        allow create: if ownsProfile(profileId);
        allow update: if false;
        allow delete: if isSuperadmin();
      }
    }

    // ── ⚠️ TEMPORAL: colecciones todavía abiertas ─────────────────────────
    //
    // Siguen exactamente como estaban, para no cambiar su comportamiento en
    // este paso:
    //
    //   implementations · flowhub_implementations · plans · resellers
    //   diagnosticos · diagnostico_config · onboardingForms
    //   distributorApplications · supportTickets · flowhub_documents
    //   flowhub_config · pipeline_configs · config · _global_config
    //   _zernio_account_map · _zernio_pending_connections
    //
    // `implementations` es la que más pesa de las que quedan: ClientPortal
    // (/portal) valida email y contraseña en el navegador contra el propio
    // documento, así que la colección tiene que ser listable sin sesión — el
    // mismo problema que tenía company_profiles. Cerrarla requiere una function
    // de sesión, no solo reglas.
    match /{coleccion}/{documento=**} {
      allow read, write: if !(coleccion in ['users', 'organizations', 'company_profiles']);
    }
  }
}
