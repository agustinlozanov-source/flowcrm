// Reglas de Firestore — archivo COMPLETO, listo para pegar en la consola.
//
// Estado: cierra company_profiles (ya publicado), users y organizations.
// El resto de las colecciones sigue abierto, marcado abajo como pendiente.
//
// ── Modelo de acceso, según el código ────────────────────────────────────────
//
// Este archivo cierra el acceso ANÓNIMO a users y organizations. La separación
// entre organizaciones queda pendiente: se intentó resolver la pertenencia con
// exists()/get() sobre users/{uid} y sobre organizations/{orgId}/members/{uid},
// y el motor devolvió "Function not found error: Name: [exists]" en ambos casos,
// sin causa clara. La vía que queda es un custom claim con el orgId.
//
// Debajo de organizations/{orgId} cuelgan 13 subcolecciones, incluida `leads`:
//   agent_files · agent_resources · alerts · appointments · brandKits
//   flowhub_goals · goals · invites · leads · members · pipeline_stages
//   pipelines · products · settings
//
// ── Lo que obliga a hacer excepciones ────────────────────────────────────────
//
// JoinPage (/join) valida la invitación ANTES de que exista sesión: lee el
// documento de la organización, lista las invitaciones filtrando por código,
// marca como expirada la que venció, y lee el miembro que invitó para mostrar
// su nombre. Si esas cuatro operaciones exigieran autenticación, nadie podría
// volver a unirse a un equipo.
//
// Esas excepciones están acotadas lo más posible y marcadas con PENDIENTE. La
// forma correcta de cerrarlas es mover la validación de invitaciones a una
// function, igual que se hizo con el acceso del formulario de perfil en
// netlify/functions/profile-session.js.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auxiliares ────────────────────────────────────────────────────────

    function isSuperadmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin';
    }

    function ownsProfile(profileId) {
      return request.auth != null && request.auth.token.profileId == profileId;
    }

    // ── users y organizations ─────────────────────────────────────────────
    //
    // Sin get() ni exists(). El motor rechazaba esas llamadas en esta ruta con
    // "Function not found error: Name: [exists]", tanto interpolando un
    // argumento como sin él, y no encontré la causa. Estas reglas no dependen de
    // esa función, así que no pueden fallar por lo mismo.
    //
    // QUÉ CIERRA: el acceso anónimo. Hoy cualquiera con la API key pública puede
    // descargar o borrar los leads de todos los clientes desde internet; con
    // esto hace falta una sesión.
    //
    // QUÉ NO CIERRA TODAVÍA: la separación entre organizaciones. Un usuario
    // autenticado de una organización podría leer los datos de otra. Eso pide
    // resolver la pertenencia dentro de las reglas, que es justo lo que no se
    // pudo — la vía que queda es meter el orgId como custom claim del token al
    // iniciar sesión, y entonces la regla se vuelve una comparación directa sin
    // consultar Firestore.

    // Las sesiones del formulario de perfil también están autenticadas, pero no
    // tienen nada que hacer aquí.
    function esUsuarioDeLaApp() {
      return request.auth != null && !('profileId' in request.auth.token);
    }

    match /users/{userId} {
      allow read, write: if esUsuarioDeLaApp();
    }

    match /organizations/{orgId} {

      // PENDIENTE: /join muestra a qué empresa te invitaron antes de que exista
      // sesión. `list` queda cerrado, así que hay que conocer el orgId.
      allow get: if true;
      allow list: if esUsuarioDeLaApp();

      allow create, update, delete: if esUsuarioDeLaApp();

      match /invites/{inviteId} {
        // PENDIENTE: /join las busca por código sin sesión, y las reglas no
        // pueden exigir que la consulta venga filtrada.
        allow read: if true;

        // La única escritura sin sesión de /join es marcar como expirada una
        // invitación vencida. Se permite exactamente eso.
        allow update: if esUsuarioDeLaApp()
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'expired');

        allow create, delete: if esUsuarioDeLaApp();
      }

      match /members/{memberId} {
        // PENDIENTE: /join lee el nombre de quien invita, sin sesión.
        allow get: if true;
        allow list, create, update, delete: if esUsuarioDeLaApp();
      }

      // Todo lo demás — aquí viven los leads.
      match /{documento=**} {
        allow read, write: if esUsuarioDeLaApp();
      }
    }

    // ── company_profiles ──────────────────────────────────────────────────

    match /company_profiles/{profileId} {

      allow create, delete: if isSuperadmin();
      allow read, update: if isSuperadmin();

      allow read: if ownsProfile(profileId);

      allow update: if ownsProfile(profileId)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['accessPassword', 'clientEmail', 'companyName',
                      'failedAttempts', 'lockedUntil', 'lastAccessAt']);

      match /submissions/{submissionId} {
        allow read: if isSuperadmin();
        allow create: if ownsProfile(profileId);
        allow update: if false;
        allow delete: if isSuperadmin();
      }
    }

    // ── ⚠️ TEMPORAL: colecciones todavía abiertas ─────────────────────────
    //
    // Siguen exactamente como estaban, para no cambiar su comportamiento en
    // este paso:
    //
    //   implementations · flowhub_implementations · plans · resellers
    //   diagnosticos · diagnostico_config · onboardingForms
    //   distributorApplications · supportTickets · flowhub_documents
    //   flowhub_config · pipeline_configs · config · _global_config
    //   _zernio_account_map · _zernio_pending_connections
    //
    // `implementations` es la que más pesa de las que quedan: ClientPortal
    // (/portal) valida email y contraseña en el navegador contra el propio
    // documento, así que la colección tiene que ser listable sin sesión — el
    // mismo problema que tenía company_profiles. Cerrarla requiere una function
    // de sesión, no solo reglas.
    match /{coleccion}/{documento=**} {
      allow read, write: if !(coleccion in ['users', 'organizations', 'company_profiles']);
    }
  }
}
