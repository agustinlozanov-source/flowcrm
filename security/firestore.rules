// Reglas de Firestore — archivo COMPLETO, listo para pegar en la consola.
// Es lo que está publicado hoy (3 de septiembre de 2026).
//
// ── Qué cierra ───────────────────────────────────────────────────────────────
//
// - Acceso anónimo a `users` y `organizations`. Antes las reglas eran
//   `match /{document=**} { allow read, write: if true }`: la base entera
//   abierta a cualquiera con la API key pública, que va en el bundle.
// - Aislamiento entre organizaciones: cada quien solo alcanza la suya.
// - `company_profiles`: cada cliente solo su perfil; el superadmin, todos.
//
// ── Cómo sabe a qué organización perteneces ──────────────────────────────────
//
// Por el claim `orgId` del token, que pone netlify/functions/sync-auth-claims a
// partir de users/{uid}, y que el cliente sincroniza al iniciar sesión desde
// src/lib/authClaims.js.
//
// Lo natural habría sido resolverlo dentro de la regla con exists()/get() sobre
// users/{uid}. El motor devolvía "Function not found error: Name: [exists]" en
// esta ruta, con argumento y sin él, sin causa clara. Con el orgId en el token
// la regla es una comparación directa: no consulta Firestore, no cuesta lecturas
// y no depende de esa función.
//
// Dos detalles que costaron encontrar:
//
// - Se lee el token con .get(clave, default), no con notación de punto: acceder
//   a una propiedad inexistente LANZA "Property orgId is undefined on object" en
//   vez de devolver vacío, y eso rompía la regla para cualquiera con una sesión
//   anterior al despliegue de sync-auth-claims.
// - Las comparaciones van escritas a mano en cada allow, sin función auxiliar,
//   para no volver a depender de nada que el motor pueda rechazar.
//
// Quien tenga una sesión vieja queda sin acceso hasta que recargue. Se arregla
// solo al recargar, porque useAuth vuelve a sincronizar.
//
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── users ─────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.get('superadmin', false) == true);
    }

    // ── organizations ─────────────────────────────────────────────────────

    match /organizations/{orgId} {

      // PENDIENTE: /join muestra a qué empresa te invitaron antes de que haya
      // sesión. `list` sí queda cerrado.
      allow get: if true;
      allow list: if request.auth != null && request.auth.token.get('superadmin', false) == true;

      allow create: if request.auth != null && !('profileId' in request.auth.token);
      allow update: if request.auth != null
        && (request.auth.token.get('orgId', '') == orgId || request.auth.token.get('superadmin', false) == true);
      allow delete: if request.auth != null && request.auth.token.get('superadmin', false) == true;

      match /invites/{inviteId} {
        // PENDIENTE: /join las busca por código sin sesión.
        allow read: if true;

        allow update: if (request.auth != null
            && (request.auth.token.get('orgId', '') == orgId || request.auth.token.get('superadmin', false) == true))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
              && request.resource.data.status == 'expired');

        allow create, delete: if request.auth != null
          && (request.auth.token.get('orgId', '') == orgId || request.auth.token.get('superadmin', false) == true);
      }

      match /members/{memberId} {
        // PENDIENTE: /join lee el nombre de quien invita, sin sesión.
        allow get: if true;

        // El alta propia la hace JoinPage justo después de crear la cuenta,
        // cuando el token todavía no trae el claim.
        allow create: if request.auth != null && request.auth.uid == memberId;

        allow list, update, delete: if request.auth != null
          && (request.auth.token.get('orgId', '') == orgId || request.auth.token.get('superadmin', false) == true);
      }

      // Aquí viven los leads.
      match /{documento=**} {
        allow read, write: if request.auth != null
          && (request.auth.token.get('orgId', '') == orgId || request.auth.token.get('superadmin', false) == true);
      }
    }

    // ── company_profiles ──────────────────────────────────────────────────
    // Sin cambios respecto a lo publicado, salvo que el superadmin se resuelve
    // por claim en vez de consultar users/{uid}.

    match /company_profiles/{profileId} {

      allow create, delete: if request.auth != null && request.auth.token.get('superadmin', false) == true;
      allow read, update: if request.auth != null && request.auth.token.get('superadmin', false) == true;

      allow read: if request.auth != null && request.auth.token.get('profileId', '') == profileId;

      allow update: if request.auth != null && request.auth.token.get('profileId', '') == profileId
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'submitted']
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['accessPassword', 'clientEmail', 'companyName',
                      'failedAttempts', 'lockedUntil', 'lastAccessAt']);

      match /submissions/{submissionId} {
        allow read: if request.auth != null && request.auth.token.get('superadmin', false) == true;
        allow create: if request.auth != null && request.auth.token.get('profileId', '') == profileId;
        allow update: if false;
        allow delete: if request.auth != null && request.auth.token.get('superadmin', false) == true;
      }
    }

    // ── ⚠️ TEMPORAL: colecciones todavía abiertas ─────────────────────────
    //
    //   implementations · flowhub_implementations · plans · resellers
    //   diagnosticos · diagnostico_config · onboardingForms
    //   distributorApplications · supportTickets · flowhub_documents
    //   flowhub_config · pipeline_configs · config · _global_config
    //   _zernio_account_map · _zernio_pending_connections
    match /{coleccion}/{documento=**} {
      allow read, write: if !(coleccion in ['users', 'organizations', 'company_profiles']);
    }
  }
}
